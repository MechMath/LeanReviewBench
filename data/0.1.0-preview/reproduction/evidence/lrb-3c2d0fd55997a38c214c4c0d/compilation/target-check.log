@KZG.CommitmentScheme.function_binding : ∀ {p : outParam ℕ} [hp : Fact (Nat.Prime p)] {G₁ : Type} [inst : Group G₁]
  [inst_1 : PrimeOrderWith G₁ p] [inst_2 : DecidableEq G₁] {G₂ : Type} [inst_3 : Group G₂]
  [inst_4 : PrimeOrderWith G₂ p] {Gₜ : Type} [inst_5 : Group Gₜ] [inst_6 : PrimeOrderWith Gₜ p]
  [inst_7 : DecidableEq Gₜ] [inst_8 : Module (ZMod p) (Additive G₁)] [inst_9 : Module (ZMod p) (Additive G₂)]
  [inst_10 : Module (ZMod p) (Additive Gₜ)] (pairing : Additive G₁ →ₗ[ZMod p] Additive G₂ →ₗ[ZMod p] Additive Gₜ)
  {n : ℕ} {g₁ : G₁} {g₂ : G₂} (L : ℕ) (hn : 1 ≤ n),
  p ≥ n + 2 →
    g₁ ≠ 1 →
      (pairing g₁) g₂ ≠ 0 →
        ∀ [SampleableType G₁] {Adv : Set (Groups.arsdhAdversary n)} (arsdhError : NNReal),
          Groups.arsdhAssumption n Adv arsdhError →
            ∀ (AuxState : Type)
              (adversary : KZG.CommitmentScheme.KzgFunctionBindingAdversary p G₁ G₂ n unifSpec L AuxState),
              KZG.CommitmentScheme.reduction pairing L hn AuxState adversary ∈ Adv →
                Commitment.functionBindingExperiment (pure ∅) OracleSpec.randomOracle ⋯ AuxState
                    (KZG.CommitmentScheme.kzg pairing) adversary ≤
                  ↑arsdhError
