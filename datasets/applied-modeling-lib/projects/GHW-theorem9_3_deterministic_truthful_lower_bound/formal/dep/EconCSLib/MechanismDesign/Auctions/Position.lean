def gspCounterexampleValues (i : Fin 3) : ℝ :=
  match i with
  | ⟨0, _⟩ => 10
  | ⟨1, _⟩ => 8
  | ⟨_, _⟩ => 1

def gspCounterexampleLowerBids (i : Fin 3) : ℝ :=
  match i with
  | ⟨0, _⟩ => 7
  | ⟨1, _⟩ => 8
  | ⟨_, _⟩ => 1

private theorem plb_gspValue0 : gspCounterexampleValues (0 : Fin 3) = 10 := sorry

attribute [local simp] plb_gspValue0

private theorem plb_gspValue1 : gspCounterexampleValues (1 : Fin 3) = 8 := sorry

attribute [local simp] plb_gspValue1

private theorem plb_gspValue2 : gspCounterexampleValues (2 : Fin 3) = 1 := sorry

attribute [local simp] plb_gspValue2

private theorem plb_gspBid0 : gspCounterexampleLowerBids (0 : Fin 3) = 7 := sorry

attribute [local simp] plb_gspBid0

private theorem plb_gspBid1 : gspCounterexampleLowerBids (1 : Fin 3) = 8 := sorry

attribute [local simp] plb_gspBid1

private theorem plb_gspBid2 : gspCounterexampleLowerBids (2 : Fin 3) = 1 := sorry

attribute [local simp] plb_gspBid2

