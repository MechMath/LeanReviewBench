import Mathlib

open scoped BigOperators

namespace EconCSLib
namespace Auction

/-
A finite position-auction environment.

`clickThroughRate s` is the expected number of clicks generated by slot `s`.
The GSP Test-of-Time papers specialize this structure to ordered sponsored
search slots with weakly decreasing click-through rates.
-/
structure PositionEnvironment (Slot : Type*) where
  clickThroughRate : Slot → ℝ

/-
An outcome for a position auction: each bidder is either assigned a slot or left
unassigned, and each bidder has a per-click payment.
-/
structure PositionOutcome (Bidder Slot : Type*) where
  slotOf : Bidder → Option Slot
  paymentPerClick : Bidder → ℝ

namespace PositionOutcome

variable {Bidder Slot : Type*}

def utility (E : PositionEnvironment Slot)
    (O : PositionOutcome Bidder Slot)
    (values : Bidder → ℝ) (i : Bidder) : ℝ :=
  match O.slotOf i with
  | none => 0
  | some s => E.clickThroughRate s * (values i - O.paymentPerClick i)

/- Expected revenue contribution from one bidder. -/
def FeasibleAssignment (O : PositionOutcome Bidder Slot) : Prop :=
  ∀ ⦃i j : Bidder⦄ ⦃s : Slot⦄,
    O.slotOf i = some s → O.slotOf j = some s → i = j

/- Every bidder receives nonnegative utility in the outcome. -/
def IndividuallyRational (E : PositionEnvironment Slot)
    (O : PositionOutcome Bidder Slot) (values : Bidder → ℝ) : Prop :=
  ∀ i, 0 ≤ O.utility E values i

end PositionOutcome

/-! ## Position mechanisms and equilibrium predicates -/

/- A position mechanism maps bid profiles to position outcomes. -/
abbrev PositionMechanism (Bidder Slot : Type*) :=
  (Bidder → ℝ) → PositionOutcome Bidder Slot

namespace PositionMechanism

variable {Bidder Slot : Type*}

/- Utility induced by a position mechanism at a bid profile. -/
def utility (E : PositionEnvironment Slot)
    (M : PositionMechanism Bidder Slot)
    (values bids : Bidder → ℝ) (i : Bidder) : ℝ :=
  (M bids).utility E values i

/- Dominant-strategy truthfulness for one-dimensional position-auction bids. -/
def IsNashEquilibrium [DecidableEq Bidder]
    (E : PositionEnvironment Slot) (M : PositionMechanism Bidder Slot)
    (values bids : Bidder → ℝ) : Prop :=
  ∀ (i : Bidder) (report : ℝ),
    utility E M values (Function.update bids i report) i ≤
      utility E M values bids i

/-
VCG-style dominant-strategy certificate for position mechanisms.

The certificate avoids committing to a particular argmax implementation: it
records that the selected outcome maximizes reported welfare, and that each
bidder's utility is reported welfare with her true value substituted, minus a
tax that is independent of her own report.
-/
end PositionMechanism

/-! ## Position-outcome envy predicates -/

namespace PositionOutcome

variable {Bidder Slot : Type*}

/-
No bidder prefers another bidder's assigned slot at that other bidder's
per-click payment. This is the outcome-level envy-freeness predicate used as a
building block for GSP equilibrium analyses.
-/
def SlotEnvyFree (E : PositionEnvironment Slot)
    (O : PositionOutcome Bidder Slot) (values : Bidder → ℝ) : Prop :=
  ∀ (i j : Bidder) (s : Slot),
    O.slotOf j = some s →
      E.clickThroughRate s * (values i - O.paymentPerClick j) ≤
        O.utility E values i

def NoProfitableAssignedSlotDeviation (E : PositionEnvironment Slot)
    (O : PositionOutcome Bidder Slot) (values : Bidder → ℝ) : Prop :=
  ∀ (i j : Bidder) (s : Slot),
    O.slotOf j = some s →
      E.clickThroughRate s * (values i - O.paymentPerClick j) ≤
        O.utility E values i

/-
Outcome-level stable assignment predicate for the EOS assignment-game bridge.
It records the finite assignment feasibility, bidder-side individual
rationality, and absence of a profitable rematch with any assigned slot at the
current per-click payment.
-/
def StableAssignment (E : PositionEnvironment Slot)
    (O : PositionOutcome Bidder Slot) (values : Bidder → ℝ) : Prop :=
  O.FeasibleAssignment ∧
    O.IndividuallyRational E values ∧
      O.NoProfitableAssignedSlotDeviation E values

theorem noProfitableAssignedSlotDeviation_of_slotEnvyFree
    (E : PositionEnvironment Slot)
    (O : PositionOutcome Bidder Slot) (values : Bidder → ℝ)
    (h : O.SlotEnvyFree E values) :
    O.NoProfitableAssignedSlotDeviation E values := by
  exact h

theorem stableAssignment_of_slotEnvyFree
    (E : PositionEnvironment Slot)
    (O : PositionOutcome Bidder Slot) (values : Bidder → ℝ)
    (hfeasible : O.FeasibleAssignment)
    (hIR : O.IndividuallyRational E values)
    (h : O.SlotEnvyFree E values) :
    O.StableAssignment E values := by
  exact ⟨hfeasible, hIR,
    O.noProfitableAssignedSlotDeviation_of_slotEnvyFree E values h⟩

end PositionOutcome

namespace PositionMechanism

variable {Bidder Slot : Type*}

/-
Static locally envy-free equilibrium for a position mechanism: bids are a pure
Nash equilibrium of the induced complete-information bidding game, and the
resulting outcome is slot-envy-free.
-/
def LocallyEnvyFreeEquilibrium [DecidableEq Bidder]
    (E : PositionEnvironment Slot) (M : PositionMechanism Bidder Slot)
    (values bids : Bidder → ℝ) : Prop :=
  M.IsNashEquilibrium E values bids ∧
    (M bids).SlotEnvyFree E values

end PositionMechanism

/-!
## A small GSP non-truthfulness witness

The 2018 SIGecom Test-of-Time award recognized the first analyses of GSP-style
position auctions.  A basic reason these papers are needed is that GSP is not a
truthful mechanism.  The following concrete three-bidder/two-slot outcome is a
minimal reusable witness: bidder `0` has value `10`, receives the top slot and
pays `8` per click when bidding truthfully, but can lower her bid to receive the
second slot and pay only `1` per click.  With click-through rates `1` and `1/2`,
that deviation improves utility from `2` to `9/2`.
-/

end Auction
end EconCSLib
