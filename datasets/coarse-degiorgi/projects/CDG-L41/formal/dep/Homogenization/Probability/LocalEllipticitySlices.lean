namespace IsEssentiallyEllipticFieldOn

theorem measurableSet {d : ℕ} {lam Lam : ℝ} {U : Set (Vec d)} {a : CoeffField d}
    (h : IsEssentiallyEllipticFieldOn lam Lam U a) :
    MeasurableSet U := sorry

end IsEssentiallyEllipticFieldOn

