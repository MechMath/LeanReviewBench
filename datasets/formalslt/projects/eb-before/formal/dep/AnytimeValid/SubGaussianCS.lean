namespace FormalSLT.AnytimeValid

noncomputable section

/-- Running sum `S_n = sum_{i < n} X_i`. -/
def runningSum {Ω : Type*} (X : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  Finset.sum (Finset.range n) fun i => X i ω

end

end FormalSLT.AnytimeValid
