namespace Eq1437

def op (a b : ℕ × Fin 3) : ℕ × Fin 3 :=
  (if a.2 = b.2 + 2 then
      (if a.1 = 0 then b.1 else a.1 - 1)
    else a.1 + 1,
    b.2 + 1)

end Eq1437
