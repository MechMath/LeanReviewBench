      "informal_target": {
        "text": "The Galois representation on the p-torsion of the Frey curve associated to a Frey package is irreducible.",
        "kind": "curator_paraphrase_of_frozen_blueprint",
        "source_path": "blueprint/src/chapter/ch02reductions.tex",
        "source_label": "Mazur_Frey",
        "source_revision": "8c4bb0b2046a1d564623057bb359212f92e0d1f2",
        "source_url": "https://github.com/ImperialCollegeLondon/FLT/blob/8c4bb0b2046a1d564623057bb359212f92e0d1f2/blueprint/src/chapter/ch02reductions.tex",
        "source_sha256": "66f0643f293ee7a7ff8dc8625e018dacf460dbd5dad68dc053de221c0459edbb",
        "exact_theorem_environment": "\\begin{theorem}[Mazur]\n  \\label{Mazur_Frey}\n  \\lean{Mazur_Frey}\n  \\uses{FreyCurve}\n  \\leanok\n  If $\\rho$ is the mod $p$ Galois representation associated to a Frey package $(a,b,c,p)$ then\n  $\\rho$ is irreducible.\n\\end{theorem}",
        "independence": "Separate mathematical LaTeX exposition, with mathematical proof prose and historical Lean annotations; not produced here by Lean-to-text. Same pinned repository revision as formal source; last-change provenance retained in evidence."
      },
      "scope_check": "This is the project-specific Frey representation root with its local curve, package and Galois representation models. Preserve the knownin1980s axiom used for the historical Mazur result; it is a proof admission, not evidence of misalignment.",
