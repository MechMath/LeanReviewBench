/-- Says that `𝔸 K`-algebra on `𝔸 L` is built from the `(NumberField.InfiniteAdeleRing K)`-algebra on `(NumberField.InfiniteAdeleRing L)` and the
finite adele algebra. -/
scoped instance : Prod.IsProdSMul (NumberField.InfiniteAdeleRing K) 𝔸ᶠ[K] (NumberField.InfiniteAdeleRing L) 𝔸ᶠ[L] where
  map_smul _ _ := rfl

scoped instance : Module.Finite (𝔸 K) (𝔸 L) :=
    Module.Finite.equiv ((baseChangeAlgEquiv K L).changeScalars (𝔸 K)).toLinearEquiv

scoped instance instIsModuleTopology : IsModuleTopology (𝔸 K) (𝔸 L) :=
  IsModuleTopology.instProd' (A := (NumberField.InfiniteAdeleRing K))

