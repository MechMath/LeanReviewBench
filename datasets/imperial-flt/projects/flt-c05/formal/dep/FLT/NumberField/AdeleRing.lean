section BaseChange

/-- `𝔸 K` for `K` a number field, is notation for `AdeleRing (𝓞 K) K`. -/
scoped[Adele] notation:max "𝔸" K => AdeleRing (𝓞 K) K

instance [SMul (𝔸 K) (𝔸 L)] : SMul ((NumberField.InfiniteAdeleRing K) × 𝔸ᶠ[K]) ((NumberField.InfiniteAdeleRing L) × 𝔸ᶠ[L]) :=
  inferInstanceAs (SMul (𝔸 K) (𝔸 L))

variable [Algebra K L]

/-- The canonical map from the adeles of K to the adeles of L -/
noncomputable def baseChange :
    (𝔸 K) →SA[algebraMap K L] 𝔸 L :=
  (InfiniteAdeleRing.baseChange K L).prodMap (FiniteAdeleRing.mapSemialgHom (𝓞 K) K L (𝓞 L))

open scoped TensorProduct

instance instPiIsModuleTopology : IsModuleTopology (𝔸 K) (Fin (Module.finrank K L) → 𝔸 K) := sorry

variable [Algebra 𝔸ᶠ[K] 𝔸ᶠ[L]] [FiniteAdeleRing.ComapFiberwiseSMul (𝓞 K) K L (𝓞 L)]

/-- The L-algebra isomorphism `L ⊗[K] 𝔸_K = 𝔸_L`. -/
noncomputable def baseChangeAlgEquiv : (L ⊗[K] 𝔸 K) ≃ₐ[L] 𝔸 L :=
  let tensor :=
    Algebra.TensorProduct.prodRight K L L (InfiniteAdeleRing K) 𝔸ᶠ[K]
  let prod := AlgEquiv.prodCongr
    (NumberField.InfiniteAdeleRing.baseChangeAlgEquiv K L)
    (FiniteAdeleRing.baseChangeAlgEquiv (𝓞 K) K L (𝓞 L))
  tensor.trans prod

open scoped NumberField.LiesOver

attribute [local instance 9999] Algebra.toModule

open TensorProduct.RightActions in
/-- Take arbitrary `Algebra K (NumberField.InfiniteAdeleRing L)`, `Algebra (NumberField.InfiniteAdeleRing K) (NumberField.InfiniteAdeleRing L)`, `Algebra 𝔸ᶠ[K] 𝔸ᶠ[L]`, Algebra K 𝔸ᶠ[L]`,
`Algebra (𝓞 K) 𝔸ᶠ[L]` and `Algebra (𝔸 K) (𝔸 L)` instances.
Assume:
- `Algebra K (NumberField.InfiniteAdeleRing L)` factors through (existing) `Algebra K L` and `Algebra L (NumberField.InfiniteAdeleRing L)`.
- `Algebra (NumberField.InfiniteAdeleRing K) (NumberField.InfiniteAdeleRing L)` and `Algebra 𝔸ᶠ[K] 𝔸ᶠ[L]` are determined by the fibers of restriction of
  places of `L` to `K` via (x • y) v = x (v.comap (algebraMap K L)) • y v.
- `Algebra K 𝔸ᶠ[L]` factors through (existing) `Algebra K L` and `Algebra L 𝔸ᶠ[L]`.
- `Algebra (𝓞 K) 𝔸ᶠ[L]` factors through `Algebra (𝓞 K) (𝓞 L)` and `Algebra (𝓞 L) 𝔸ᶠ[L]`.
-  `Algebra (𝔸 K) (𝔸 L)` is constructed as the product algebra from `Algebra (NumberField.InfiniteAdeleRing K) (NumberField.InfiniteAdeleRing L)` and
  `Algebra 𝔸ᶠ[K] 𝔸ᶠ[L].
Then the `L` algebra base change map is also linear in `𝔸 K`. -/
instance [Algebra (NumberField.InfiniteAdeleRing K) (NumberField.InfiniteAdeleRing L)] [Algebra (𝔸 K) (𝔸 L)]
    [Pi.FiberwiseSMul (fun a => a.comap (algebraMap K L)) Completion Completion]
    [Prod.IsProdSMul (NumberField.InfiniteAdeleRing K) 𝔸ᶠ[K] (NumberField.InfiniteAdeleRing L) 𝔸ᶠ[L]] :
    IsBiscalar L (𝔸 K) (baseChangeAlgEquiv K L).toAlgHom := sorry

variable [Algebra (NumberField.InfiniteAdeleRing K) (NumberField.InfiniteAdeleRing L)]
  [Pi.FiberwiseSMul (fun a => a.comap (algebraMap K L)) Completion Completion]

variable [Algebra (𝔸 K) (𝔸 L)]
  [Prod.IsProdSMul (NumberField.InfiniteAdeleRing K) (FiniteAdeleRing (𝓞 K) K) (NumberField.InfiniteAdeleRing L) (FiniteAdeleRing (𝓞 L) L)]

variable {L} [IsModuleTopology (𝔸 K) (𝔸 L)]

variable (L)

variable {K L}

variable (K L)

