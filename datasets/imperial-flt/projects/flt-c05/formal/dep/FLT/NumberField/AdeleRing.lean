    [Module (𝔸 K) (V ⊗[L] 𝔸 L)] [IsScalarTower (𝔸 K) (𝔸 L) (V ⊗[L] 𝔸 L)] :
    IsBiscalar L (𝔸 K) (ModuleBaseChangeLinearEquiv K L V) := sorry

